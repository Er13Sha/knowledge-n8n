APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=knowledge_system
DB_USERNAME=knowledge_system
DB_PASSWORD=knowledge-system-secret
POSTGRES_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq
DB_QUEUE_RETRY_AFTER=960
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_IMAGE=rabbitmq:4.2.9-management-alpine
RABBITMQ_USER=knowledge_system
RABBITMQ_PASSWORD=knowledge-system-rabbitmq-secret
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=knowledge-documents
RABBITMQ_HEARTBEAT=30
RABBITMQ_CONNECTION_TIMEOUT=5
RABBITMQ_READ_TIMEOUT=65
RABBITMQ_WRITE_TIMEOUT=10
RABBITMQ_CHANNEL_RPC_TIMEOUT=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OLLAMA_URL=http://localhost:11434
DOCKER_OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=600

N8N_INDEX_WEBHOOK_URL=http://localhost:5678/webhook/knowledge-index
N8N_SEARCH_WEBHOOK_URL=http://localhost:5678/webhook/knowledge-search
N8N_DELETE_WEBHOOK_URL=http://localhost:5678/webhook/knowledge-delete
DOCKER_N8N_INDEX_WEBHOOK_URL=http://n8n:5678/webhook/knowledge-index
DOCKER_N8N_SEARCH_WEBHOOK_URL=http://n8n:5678/webhook/knowledge-search
DOCKER_N8N_DELETE_WEBHOOK_URL=http://n8n:5678/webhook/knowledge-delete
N8N_TIMEOUT=600
N8N_IMAGE=n8nio/n8n:2.33.4
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

RAG_INTERNAL_TOKEN=replace-with-a-long-random-rag-token
DOCUMENT_PROCESSOR_URL=http://localhost:8001
DOCKER_DOCUMENT_PROCESSOR_URL=http://document-processor:8000
DOCUMENT_PROCESSOR_TOKEN=replace-with-a-long-random-document-processor-token
DOCUMENT_PROCESSOR_TIMEOUT=600
DOCUMENT_PROCESSOR_PORT=8001
DOCUMENT_PROCESSOR_MAX_FILE_MB=100
DOCUMENT_PROCESSOR_MAX_PAGES=2000
DOCUMENT_PROCESSOR_OCR_MIN_TEXT_CHARS=40
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=200
RAG_EMBEDDING_BATCH_SIZE=16
RAG_OCR_LANGUAGES=rus+eng
RAG_OCR_DPI=200
RAG_OCR_PAGE_TIMEOUT=120
RAG_TOP_K=6
RAG_LEXICAL_RESULT_LIMIT=50
RAG_LEXICAL_CANDIDATE_LIMIT=1000
RAG_SCORE_THRESHOLD=0.25
RAG_CONTEXT_MAX_CHARS=16000
RAG_REQUEST_TIMEOUT=600
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_API_KEY=knowledge-system-qdrant-key
QDRANT_COLLECTION=knowledge_documents

VITE_APP_NAME="${APP_NAME}"
